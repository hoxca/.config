{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
  ],
  // "model": "ollama/qwen3-coder:30b", // set default model
  "provider": {
    "google": {
      "name": "gemini",
    },
    "ollama": { // provider id
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:latest": { // configure the model
          "name": "Qwen3 Coder 30b Local",
          "tools": true,
          "reasoning": true,
          "flash_attention": true,
        },
        "llama3.1:8b": {
          "name": "llama3.1:8b",
          "tools": true,
          "reasoning": true,
          "flash_attention": true,
        },
        "gemma4:12b-mlx": {
          "name": "gemma4:12b mlx",
          "tools": true,
          "reasoning": true,
          "flash_attention": true,
          "options": {
            "temperature": 0.2
          },
          "features": {
            "autocomplete": true,
            "chat": true,
            "inline_edit": true,
            "multi_token_prediction": true
          }
        }
      }
    }
  },
  "mode": {
    "build": {
      "temperature": 0.2
    },
    "analyze": {
      "temperature": 0.1
    },
    "brainstorm": {
      "temperature": 0.7
    }
  }
}
